# Optional Gemini server gateway — server key must NEVER be prefixed NEXT_PUBLIC
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_PREMIUM_MODEL=gemini-3.1-flash-image

# Free-tier demo control: weighted REQUEST units/day, NOT USD or provider billing.
# Each text request consumes 1 unit, each image request 5. Set 0 to disable.
# A single-host disk-backed limiter is sufficient for LOCAL demos only.
# Multi-instance public deployment requires external atomic quota storage.
GEMINI_DAILY_BUDGET=25
# Set ONLY if the hosting provider sanitizes the named platform headers.
# TRUSTED_PROXY_PLATFORM=vercel

# Frontend static Pages -> separately hosted Next.js gateway (set at BUILD time)
# NEXT_PUBLIC_GEMINI_GATEWAY_URL=https://your-gateway.example
NEXT_PUBLIC_ENABLE_CLOUD_ACCOUNTS=false
