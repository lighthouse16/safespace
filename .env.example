# Gemini Server-Side Configuration (Never expose to client or NEXT_PUBLIC)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_PREMIUM_MODEL=gemini-3.1-flash-image

# Optional Gemini Gateway URL for static GitHub Pages guest deployment
# If empty, Next.js /api/gemini routes are used locally or on full-stack host
# NEXT_PUBLIC_GEMINI_GATEWAY_URL=
