# SafeSpace backend runtime — these values belong on the Next.js server.
# Use the current HTTPS tunnel for a temporary Colab experiment, or a stable
# endpoint after deploying M3DLayout on a GPU inference service.
M3D_INFERENCE_URL=
# Optional bearer credential sent from the SafeSpace backend to inference API.
# Do not set a real key in this file or use NEXT_PUBLIC_ for these values.
M3D_INFERENCE_TOKEN=

# The following are separate, optional services already used by SafeSpace.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
